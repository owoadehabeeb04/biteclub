{
  "$description": "BITECLUB design tokens v1. Arcade sticker look: flat fills, 3px Void outlines, hard offset shadows, zero blur. Gold is reserved for $BITE and rewards.",
  "color": {
    "ink": { "value": "#0D130E", "use": "Page background" },
    "pit": { "value": "#152019", "use": "Panels, arena floor" },
    "moss": { "value": "#1F2E24", "use": "Grid lines, hard shadow on dark" },
    "lime": { "value": "#8CFF2E", "use": "Primary, player snake, CTA" },
    "limeDeep": { "value": "#5BC014", "use": "Button press edge, scale spots" },
    "bone": { "value": "#F3EFDC", "use": "Text, highlights" },
    "gold": { "value": "#FFC21A", "use": "$BITE and rewards only" },
    "goldDeep": { "value": "#C98F00", "use": "Coin rim, gold button press edge" },
    "red": { "value": "#FF4A2E", "use": "Danger, death, arena boundary, failures" },
    "redDeep": { "value": "#A82E18", "use": "Danger button press edge" },
    "void": { "value": "#050805", "use": "Outlines, dark text on bright fills" },
    "muted": { "value": "#A9B5A3", "use": "Secondary text on dark" },
    "bot": {
      "pink": { "value": "#FF3D8B" },
      "cyan": { "value": "#2ED8FF" },
      "orange": { "value": "#FF8A1F" },
      "violet": { "value": "#9B5CFF" },
      "teal": { "value": "#17D6A3" },
      "yellow": { "value": "#FFE53D" }
    }
  },
  "font": {
    "display": { "value": "'Bungee', 'Arial Black', sans-serif", "use": "Headings, buttons, big numbers" },
    "body": { "value": "'Rubik', Arial, sans-serif", "use": "Paragraphs, UI text" },
    "mono": { "value": "'Space Mono', monospace", "use": "Scores, addresses, labels" }
  },
  "text": {
    "displayXl": { "size": "96px", "lineHeight": "1", "font": "display" },
    "displayL": { "size": "56px", "lineHeight": "1.05", "font": "display" },
    "heading": { "size": "32px", "lineHeight": "1.1", "font": "display" },
    "bodyL": { "size": "20px", "lineHeight": "1.5", "weight": 400, "font": "body" },
    "body": { "size": "16px", "lineHeight": "1.5", "weight": 400, "font": "body" },
    "small": { "size": "14px", "lineHeight": "1.45", "weight": 500, "font": "body" },
    "label": { "size": "12px", "lineHeight": "1.3", "weight": 700, "letterSpacing": "1px", "font": "mono", "transform": "uppercase" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "xl": "20px", "pill": "999px" },
  "border": { "divider": "2px", "default": "3px", "card": "4px", "color": "#050805" },
  "shadow": {
    "sm": "4px 4px 0 #1F2E24",
    "md": "6px 6px 0 #1F2E24",
    "lg": "8px 8px 0 #1F2E24",
    "limeSm": "4px 4px 0 #8CFF2E",
    "limeMd": "6px 6px 0 #8CFF2E",
    "pressLime": "0 6px 0 #5BC014",
    "pressGold": "0 6px 0 #C98F00",
    "pressRed": "0 6px 0 #A82E18"
  },
  "motion": {
    "fast": "120ms ease-out",
    "panel": "240ms ease-out",
    "coinPop": "400ms cubic-bezier(0.3, 1.6, 0.5, 1)"
  }
}
