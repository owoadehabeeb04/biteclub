# Copy this file to .env.local and fill it in. .env.local is ignored by git.
# A free project ID from https://dashboard.reown.com (public, not a secret). Without it, only browser wallets work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# A Postgres connection string. Needed on Vercel, which has no writable disk (the local SQLite file can't work there).
# Adding a database in the Vercel dashboard (Storage tab, Neon/Postgres) sets this and POSTGRES_URL for you.
# Leave it empty locally and the app uses a SQLite file under .data/ instead. The tables are created on the first request.
DATABASE_URL=
